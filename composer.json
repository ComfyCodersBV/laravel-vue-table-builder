{
    "name": "tranquil-tools/laravel-vue-table-builder",
    "description": "A VueJS/Inertia renderer for tranquil-tools/laravel-table-builder",
    "keywords": [
        "ComfyCoders BV",
        "laravel",
        "laravel-vue-table-builder"
    ],
    "homepage": "https://github.com/comfycodersbv/laravel-vue-table-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "ComfyCoders BV",
            "email": "development@comfycoders.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "tranquil-tools/laravel-table-builder": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "TranquilTools\\VueTableBuilder\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "TranquilTools\\VueTableBuilder\\VueTableBuilderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
